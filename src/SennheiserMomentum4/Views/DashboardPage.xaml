<UserControl x:Class="SennheiserMomentum4.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="920">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- Sennheiser Hero Showcase Card (Inspired by Smart Control Mobile App) -->
            <Border Style="{DynamicResource ModernCardStyle}" Padding="24,20" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Device Telemetry & Quick Status -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Brand Label -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Image Source="pack://application:,,,/Resources/Images/sennheiser_logo.png"
                                   Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="SENNHEISER • SMART CONTROL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Product Title -->
                        <TextBlock Text="MOMENTUM 4" Style="{StaticResource AppHeaderStyle}" FontSize="28" Margin="0,0,0,4" />
                        <TextBlock Text="Wireless Over-Ear Headphones with Adaptive ANC" Style="{StaticResource SubheadStyle}" Margin="0,0,0,14" />

                        <!-- Status Telemetry Badges -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <!-- Dynamic Connection Pill -->
                            <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding ConnectionStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DeviceInfo.State}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Quick Connect Button when Disconnected -->
                            <Button Style="{StaticResource SennheiserAccentButtonStyle}" 
                                    Content="Connect" Padding="12,4" Margin="0,0,8,8"
                                    Command="{Binding ConnectDeviceCommand}"
                                    Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Quick Disconnect Button when Connected -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" 
                                    Content="Disconnect" Padding="10,4" Margin="0,0,8,8"
                                    Command="{Binding DisconnectDeviceCommand}"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Switch to Demo Mode Button when Disconnected -->
                            <Button Style="{StaticResource SecondaryButtonStyle}" 
                                    Content="🎮 Use Demo Mode" Padding="10,4" Margin="0,0,8,8"
                                    Command="{Binding SwitchToDemoModeCommand}"
                                    Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisConverter}}" />

                            <!-- Battery Pill (Visible when connected) -->
                            <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,8,8"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔋 " FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DeviceInfo.BatteryPercentage, StringFormat={}{0}% Battery}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Active Noise Cancellation Pill (Visible when connected) -->
                            <Border Background="{DynamicResource SennheiserRedSubtleBrush}" BorderBrush="{DynamicResource SennheiserRedBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,8,8"
                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️ " FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActiveNoiseModeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SennheiserRedBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Codec Pill -->
                            <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding DeviceInfo.AudioCodec}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>

                            <!-- Demo Mode Pill & Exit Button -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,8,8">
                                <Border Background="{DynamicResource SennheiserRedSubtleBrush}" CornerRadius="16" Padding="10,6" Margin="0,0,6,0">
                                    <TextBlock Text="DEMO MODE (SIMULATED)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SennheiserRedBrush}" />
                                </Border>
                                <Button Style="{StaticResource SennheiserAccentButtonStyle}" 
                                        Content="⚡ Switch to Live Bluetooth" Padding="10,4"
                                        Command="{Binding SwitchToLiveModeCommand}" />
                            </StackPanel>
                        </WrapPanel>

                        <!-- Auto-Detected Hardware Finish Telemetry (Smart Control Automatic Detection) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Hardware Finish:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#4A6572" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedColorVariant}" Value="Denim">
                                                        <Setter Property="Fill" Value="#2E5B88" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedColorVariant}" Value="White">
                                                        <Setter Property="Fill" Value="#E5E5EA" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedColorVariant}" Value="Black">
                                                        <Setter Property="Fill" Value="#1C1C1E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedColorVariant}" Value="Copper">
                                                        <Setter Property="Fill" Value="#C87A3E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedColorVariant}" Value="Graphite">
                                                        <Setter Property="Fill" Value="#636366" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ColorFinishDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="• Auto-Detected" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Real Photorealistic MOMENTUM 4 Image (Official App Visual with subtle hover micro-animation) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="16" Background="Transparent" Padding="4">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0" CenterX="155" CenterY="155" />
                                <TranslateTransform Y="0" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                     To="1.035" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                     To="1.035" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                     To="-4" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                     To="1.0" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                     To="1.0" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                     To="0" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Image Source="{Binding ProductImageSource}"
                                   Width="310" Height="310" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Grid 2-Column: Noise Cancellation Card & Equalizer Card -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CARD 1: Noise Cancellation (Smart Control Pattern) -->
                <Border Grid.Column="0" Style="{DynamicResource ModernCardStyle}" Padding="20">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Noise Cancellation" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Background="{DynamicResource SennheiserRedSubtleBrush}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ActiveNoiseModeDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SennheiserRedBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="Adaptive hybrid active noise cancellation and transparency" Style="{StaticResource CaptionStyle}" Margin="0,0,0,14" />

                        <!-- Segmented Mode Selection (Highlights Active Mode) -->
                        <Border Background="{DynamicResource CardSecondaryBrush}" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="3" 
                                Margin="0,0,0,16">
                            <UniformGrid Columns="3" Rows="1">
                                <RadioButton GroupName="DashboardNoiseMode"
                                             Style="{StaticResource SegmentedRadioButtonStyle}"
                                             Content="Adaptive ANC"
                                             IsChecked="{Binding IsAdaptiveAnc, Mode=OneWay}"
                                             Command="{Binding SetQuickNoiseControlCommand}"
                                             CommandParameter="AdaptiveAnc"
                                             Margin="1,0" />

                                <RadioButton GroupName="DashboardNoiseMode"
                                             Style="{StaticResource SegmentedRadioButtonStyle}"
                                             Content="Transparency"
                                             IsChecked="{Binding IsTransparency, Mode=OneWay}"
                                             Command="{Binding SetQuickNoiseControlCommand}"
                                             CommandParameter="Transparency"
                                             Margin="1,0" />

                                <RadioButton GroupName="DashboardNoiseMode"
                                             Style="{StaticResource SegmentedRadioButtonStyle}"
                                             Content="Off"
                                             IsChecked="{Binding IsOff, Mode=OneWay}"
                                             Command="{Binding SetQuickNoiseControlCommand}"
                                             CommandParameter="Off"
                                             Margin="1,0" />
                            </UniformGrid>
                        </Border>

                        <!-- Active Mode Status Detail -->
                        <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Current Profile" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ActiveNoiseModeDisplay, StringFormat={}Mode: {0}}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding NoiseControl.AncIntensity, StringFormat={}{0:F0}% Attenuation}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource SennheiserRedBrush}" />
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Open Full Noise Controls →"
                                HorizontalAlignment="Left"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="NoiseControl" />
                    </StackPanel>
                </Border>

                <!-- CARD 2: Equalizer (Smart Control Pattern) -->
                <Border Grid.Column="2" Style="{DynamicResource ModernCardStyle}" Padding="20">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎚️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Equalizer" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding CurrentPresetName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="5-band internal headphone DSP sound customization" Style="{StaticResource CaptionStyle}" Margin="0,0,0,14" />

                        <!-- Quick Sound Mode Chips (Like in Sennheiser App!) -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Margin="0,0,8,0" Padding="12,6"
                                    Command="{Binding ToggleBassBoostCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="💥 Bass Boost" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBassBoostEnabled}" Value="True">
                                                <Setter Property="Content" Value="💥 Bass Boost (Active)" />
                                                <Setter Property="Background" Value="{DynamicResource SennheiserRedBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SennheiserRedBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Margin="0,0,8,0" Padding="12,6"
                                    Command="{Binding TogglePodcastModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="🎙️ Podcast (Vocals)" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPodcastModeEnabled}" Value="True">
                                                <Setter Property="Content" Value="🎙️ Podcast (Active)" />
                                                <Setter Property="Background" Value="{DynamicResource SennheiserRedBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SennheiserRedBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>

                        <!-- Equalizer Waveform Curve Preview -->
                        <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="DSP Frequency Curve" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <!-- Responsive SVG curve -->
                                <Path Data="M 10,25 C 60,10 110,35 170,20 C 230,5 280,30 330,15"
                                      Stroke="{DynamicResource SennheiserRedBrush}"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Height="35" Stretch="Fill" />
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="63 Hz" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Text="1 kHz" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="8 kHz" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                                Content="Open 5-Band Equalizer →"
                                HorizontalAlignment="Left"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Sound" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Connections & Multi-Point Card (Smart Control Mobile App Signature Card) -->
            <Border Style="{DynamicResource ModernCardStyle}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📶" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Connections &amp; Multi-Point" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            
                            <!-- Dynamic Multi-Point Audio Source Badge -->
                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource CardSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPcAudioActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SennheiserRedSubtleBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding MultiPointBadgeText}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPcAudioActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SennheiserRedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                        <TextBlock Text="Headphones automatically switch audio to your phone when music plays or an incoming call arrives" 
                                   Style="{StaticResource CaptionStyle}" Margin="0,0,0,14" />

                        <WrapPanel Orientation="Horizontal">
                            <!-- Host Device 1 (This PC) -->
                            <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,10,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPcAudioActive}" Value="True">
                                                <Setter Property="BorderThickness" Value="1.5" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SennheiserRedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Live Pulsing Beacon when Audio is Actively Streaming -->
                                    <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                          Visibility="{Binding IsPcAudioActive, Converter={StaticResource BoolToVisConverter}}">
                                        <Ellipse Width="14" Height="14" Fill="{DynamicResource SuccessBrush}" Opacity="0.3">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.15" To="0.75" Duration="0:0:0.9" AutoReverse="True">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="💻 " FontSize="14" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="This Windows PC" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding PcAudioStatusText}" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPcAudioActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Host Device 2 (Phone) -->
                            <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,10,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPcAudioActive}" Value="False">
                                                <Setter Property="BorderThickness" Value="1.5" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📱 " FontSize="14" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Mobile Smartphone" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding MobileAudioStatusText}" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPcAudioActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                            Content="Device Settings →"
                            VerticalAlignment="Center"
                            Padding="12,8"
                            Command="{Binding NavigateToCommand}"
                            CommandParameter="Device" />
                </Grid>
            </Border>

            <!-- Bottom Row: Windows Desktop Media Player & Volume Control (Windows Companion Specific) -->
            <Border Style="{DynamicResource ModernCardStyle}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Media Playback Preview -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Desktop Media Integration" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="Windows System Media Transport Controls (GSMTC)" Style="{StaticResource CaptionStyle}" Margin="0,0,0,10" />

                        <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MediaInfo.Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding MediaInfo.Artist}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="⏮" Padding="8,4" Margin="0,0,4,0" Command="{Binding PreviousTrackCommand}" />
                                    <Button Style="{StaticResource SennheiserAccentButtonStyle}" Content="⏯" Padding="10,4" Margin="0,0,4,0" Command="{Binding TogglePlayPauseCommand}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="⏭" Padding="8,4" Command="{Binding NextTrackCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right: Headphone Volume Slider (Shielded from Bluetooth AVRCP loop) -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Headphone Volume" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{Binding SystemVolume, StringFormat={}{0}%}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SennheiserRedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding AudioDeviceName}" Style="{StaticResource CaptionStyle}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" 
                                    Content="🔊" Padding="8,4" Margin="0,0,10,0"
                                    Command="{Binding ToggleMuteCommand}" />

                            <Slider Grid.Column="1" Style="{StaticResource ModernSliderStyle}"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding SystemVolume, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Banner -->
            <TextBlock Text="{Binding LastOperationStatus}" 
                       Style="{StaticResource CaptionStyle}" 
                       Foreground="{DynamicResource SennheiserRedBrush}" 
                       HorizontalAlignment="Center"
                       Margin="0,4,0,10" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
