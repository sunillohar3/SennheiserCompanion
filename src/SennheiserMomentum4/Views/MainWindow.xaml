<Window x:Class="SennheiserMomentum4.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:SennheiserMomentum4.ViewModels"
        xmlns:views="clr-namespace:SennheiserMomentum4.Views"
        mc:Ignorable="d"
        Title="Sennheiser Companion"
        Icon="pack://application:,,,/Resources/app.ico"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="navBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{DynamicResource SennheiserRedBrush}" />
                                <Setter TargetName="navBorder" Property="BorderThickness" Value="3,0,0,0" />
                                <Setter TargetName="navBorder" Property="Padding" Value="14,10,10,10" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="navBorder" Property="Padding" Value="15,10,9,10" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sidebar Brand Header -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Official Sennheiser Logo Mark -->
                        <Image Source="pack://application:,,,/Resources/Images/sennheiser_logo.png"
                               Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="SENNHEISER" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="MOMENTUM 4" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1" Margin="12,0,12,0">
                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="NavGroup"
                                 Content="📊  Dashboard"
                                 IsChecked="{Binding CurrentNavKey, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter=Dashboard}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="Dashboard" />

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="NavGroup"
                                 Content="🎚️  Sound (EQ)"
                                 IsChecked="{Binding CurrentNavKey, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter=Sound}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="Sound" />

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="NavGroup"
                                 Content="🛡️  Noise Control"
                                 IsChecked="{Binding CurrentNavKey, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter=NoiseControl}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="NoiseControl" />

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="NavGroup"
                                 Content="🎧  Device"
                                 IsChecked="{Binding CurrentNavKey, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter=Device}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="Device" />

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="NavGroup"
                                 Content="⚙️  Settings"
                                 IsChecked="{Binding CurrentNavKey, Mode=OneWay, Converter={StaticResource EqualityConverter}, ConverterParameter=Settings}"
                                 Command="{Binding NavigateToCommand}"
                                 CommandParameter="Settings" />
                </StackPanel>

                <!-- Sidebar Footer Status -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="{Binding DeviceInfo.State}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding DeviceInfo.BatteryPercentage, StringFormat={}Battery: {0}%}" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                Content="⚙" Padding="8,4" VerticalAlignment="Center"
                                Command="{Binding NavigateToCommand}" CommandParameter="Settings"
                                ToolTip="Open Settings" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Live Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MOMENTUM 4" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Wireless Headphones" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />

                        <!-- Demo Mode Alert Pill -->
                        <Border Background="{DynamicResource SennheiserRedSubtleBrush}" 
                                CornerRadius="4" Margin="14,0,0,0" Padding="8,3" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="DEMO MODE (Simulated)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SennheiserRedBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Top-Right Actions: Quick Theme Toggle -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="☀/◐ Theme"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip="Toggle Light / Dark theme" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page Content Body with Smooth Fade-Slide Navigation Transition -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPageViewModel}">
                <ContentControl.Resources>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="0" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.0" To="1.0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="10" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
