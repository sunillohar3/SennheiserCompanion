<UserControl x:Class="SennheiserMomentum4.Views.NoiseControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">

            <!-- Title Section -->
            <TextBlock Text="Noise Control" Style="{StaticResource AppHeaderStyle}" />
            <TextBlock Text="Adjust Active Noise Cancellation and Transparency levels for MOMENTUM 4" 
                       Style="{StaticResource SubheadStyle}" Margin="0,4,0,20" />

            <!-- Capability Banner (Strict Non-Fake Requirement) -->
            <Border Background="{DynamicResource CardSecondaryBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ℹ️" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Bluetooth Interface Capability" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding InterfaceMessage}" 
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Mode Selection Card -->
            <Border Style="{DynamicResource ModernCardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Mode Selection" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="Select active environmental attenuation mode" Style="{StaticResource CaptionStyle}" Margin="0,0,0,16" />

                    <Border Background="{DynamicResource CardSecondaryBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="3" 
                            Margin="0,0,0,8">
                        <UniformGrid Columns="3" Rows="1">
                            <RadioButton GroupName="NoiseControlPageMode"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         Content="Adaptive ANC"
                                         IsChecked="{Binding IsAdaptiveAnc, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}"
                                         CommandParameter="AdaptiveAnc"
                                         Margin="1,0" />

                            <RadioButton GroupName="NoiseControlPageMode"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         Content="Transparency"
                                         IsChecked="{Binding IsTransparency, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}"
                                         CommandParameter="Transparency"
                                         Margin="1,0" />

                            <RadioButton GroupName="NoiseControlPageMode"
                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                         Content="Off"
                                         IsChecked="{Binding IsOff, Mode=OneWay}"
                                         Command="{Binding SelectModeCommand}"
                                         CommandParameter="Off"
                                         Margin="1,0" />
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sliders Card -->
            <Border Style="{DynamicResource ModernCardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Intensity Adjustments" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16" />

                    <!-- ANC Intensity -->
                    <Grid Margin="0,0,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Noise Cancellation Intensity" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AncIntensity, StringFormat={}{0:F0}%}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SennheiserRedBrush}" />

                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ModernSliderStyle}"
                                Minimum="0" Maximum="100" Margin="0,8,0,0"
                                Value="{Binding AncIntensity, Mode=TwoWay}" />
                    </Grid>

                    <!-- Transparency Intensity -->
                    <Grid Margin="0,0,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Transparency Level" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TransparencyIntensity, StringFormat={}{0:F0}%}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SennheiserRedBrush}" />

                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ModernSliderStyle}"
                                Minimum="0" Maximum="100" Margin="0,8,0,0"
                                Value="{Binding TransparencyIntensity, Mode=TwoWay}" />
                    </Grid>

                    <!-- Wind Noise Reduction Toggle -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Wind Noise Reduction" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Suppresses wind turbulence across outer microphones" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding WindNoiseReduction, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Apply Settings Button -->
                    <Button Style="{StaticResource SennheiserAccentButtonStyle}"
                            Content="Apply to MOMENTUM 4"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding UpdateSettingsCommand}" />
                </StackPanel>
            </Border>

            <!-- Status Feedback -->
            <TextBlock Text="{Binding StatusMessage}" 
                       Style="{StaticResource CaptionStyle}"
                       Foreground="{DynamicResource SennheiserRedBrush}"
                       Margin="4,0,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
