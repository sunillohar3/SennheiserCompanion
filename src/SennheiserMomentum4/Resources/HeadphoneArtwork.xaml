<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sennheiser MOMENTUM 4 Minimal Vector Illustration -->
    <ControlTemplate x:Key="Momentum4IllustrationTemplate">
        <Viewbox Stretch="Uniform" Width="140" Height="140">
            <Canvas Width="200" Height="200">
                <!-- Headband outer arc -->
                <Path Data="M 30,120 C 30,35 170,35 170,120"
                      Stroke="{DynamicResource TextPrimaryBrush}"
                      StrokeThickness="10"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />

                <!-- Headband cushion inner arc -->
                <Path Data="M 45,108 C 45,55 155,55 155,108"
                      Stroke="{DynamicResource BorderBrush}"
                      StrokeThickness="4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />

                <!-- Left Hinge / Gimbal -->
                <Rectangle Canvas.Left="26" Canvas.Top="115" Width="14" Height="18" RadiusX="3" RadiusY="3"
                           Fill="{DynamicResource CardBrush}"
                           Stroke="{DynamicResource BorderBrush}"
                           StrokeThickness="1.5" />

                <!-- Right Hinge / Gimbal -->
                <Rectangle Canvas.Left="160" Canvas.Top="115" Width="14" Height="18" RadiusX="3" RadiusY="3"
                           Fill="{DynamicResource CardBrush}"
                           Stroke="{DynamicResource BorderBrush}"
                           StrokeThickness="1.5" />

                <!-- Left Earcup (Matte Oval) -->
                <Ellipse Canvas.Left="15" Canvas.Top="122" Width="36" Height="58"
                         Fill="{DynamicResource CardBrush}"
                         Stroke="{DynamicResource BorderBrush}"
                         StrokeThickness="2" />
                <Ellipse Canvas.Left="22" Canvas.Top="130" Width="22" Height="42"
                         Fill="{DynamicResource BackgroundBrush}"
                         Opacity="0.4" />
                <!-- Left Accent indicator -->
                <Ellipse Canvas.Left="29" Canvas.Top="148" Width="8" Height="8"
                         Fill="{DynamicResource SennheiserRedBrush}"
                         Opacity="0.8" />

                <!-- Right Earcup (Matte Oval) -->
                <Ellipse Canvas.Left="149" Canvas.Top="122" Width="36" Height="58"
                         Fill="{DynamicResource CardBrush}"
                         Stroke="{DynamicResource BorderBrush}"
                         StrokeThickness="2" />
                <Ellipse Canvas.Left="156" Canvas.Top="130" Width="22" Height="42"
                         Fill="{DynamicResource BackgroundBrush}"
                         Opacity="0.4" />
                <!-- Right Accent indicator -->
                <Ellipse Canvas.Left="163" Canvas.Top="148" Width="8" Height="8"
                         Fill="{DynamicResource SennheiserRedBrush}"
                         Opacity="0.8" />

                <!-- Minimal sound waves (subtle) -->
                <Path Data="M 7,140 C 3,146 3,156 7,162"
                      Stroke="{DynamicResource SennheiserRedBrush}"
                      StrokeThickness="1.5"
                      Opacity="0.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
                <Path Data="M 193,140 C 197,146 197,156 193,162"
                      Stroke="{DynamicResource SennheiserRedBrush}"
                      StrokeThickness="1.5"
                      Opacity="0.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Canvas>
        </Viewbox>
    </ControlTemplate>

</ResourceDictionary>
